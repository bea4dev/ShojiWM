{
  "name": "shoji-wm-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -p packages/shoji_wm/tsconfig.json && tsc -p packages/config/tsconfig.json",
    "test:overlays": "node --import tsx --test tests/output-overlay.test.ts && tsc -p tests/tsconfig.overlays.json",
    "test:output-power": "node --import tsx --test tests/output-power.test.ts",
    "test:headless-output": "node --import tsx --test tests/headless-output.test.ts",
    "test:lid-policy": "node --import tsx --test tests/lid-policy.test.ts"
  },
  "devDependencies": {
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
